"""
generate_sample_data.py
------------------------
Creates a small SYNTHETIC Airbnb-style dataset purely so you can test-run
airbnb_analysis.py end-to-end and see real charts come out the other side.

THIS IS NOT YOUR ASSIGNED DATASET. Before submitting, replace
Airbnb_Open_Data.csv with the actual dataset you were given, and re-run
airbnb_analysis.py to produce your real charts.
"""

import numpy as np
import pandas as pd

np.random.seed(42)
n = 2000

neighbourhood_groups = ["Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island"]
neighbourhoods_map = {
    "Manhattan": ["Harlem", "Chelsea", "SoHo", "Upper West Side"],
    "Brooklyn": ["Williamsburg", "Bushwick", "Park Slope", "Bedford-Stuyvesant"],
    "Queens": ["Astoria", "Flushing", "Long Island City"],
    "Bronx": ["Fordham", "Riverdale"],
    "Staten Island": ["St. George", "Tottenville"],
}
room_types = ["Entire home/apt", "Private room", "Shared room"]

rows = []
for i in range(n):
    group = np.random.choice(neighbourhood_groups, p=[0.4, 0.35, 0.15, 0.06, 0.04])
    neighbourhood = np.random.choice(neighbourhoods_map[group])
    room_type = np.random.choice(room_types, p=[0.55, 0.4, 0.05])

    base_price = {"Manhattan": 180, "Brooklyn": 130, "Queens": 95, "Bronx": 70, "Staten Island": 80}[group]
    room_adj = {"Entire home/apt": 1.3, "Private room": 0.75, "Shared room": 0.45}[room_type]
    price = max(20, np.random.normal(base_price * room_adj, 40))

    rows.append({
        "id": i + 1,
        "name": f"Listing {i+1}",
        "host_id": np.random.randint(1000, 9999),
        "host_name": f"Host{np.random.randint(1, 500)}",
        "neighbourhood_group": group,
        "neighbourhood": neighbourhood,
        "latitude": round(np.random.uniform(40.5, 40.9), 5),
        "longitude": round(np.random.uniform(-74.05, -73.7), 5),
        "room_type": room_type,
        "price": round(price, 2),
        "minimum_nights": np.random.choice([1, 2, 3, 5, 7, 30], p=[0.4, 0.25, 0.15, 0.1, 0.07, 0.03]),
        "number_of_reviews": np.random.poisson(20),
        "last_review": "2023-06-15",
        "reviews_per_month": round(np.random.exponential(1.2), 2),
        "calculated_host_listings_count": np.random.randint(1, 10),
        "availability_365": np.random.randint(0, 366),
    })

df = pd.DataFrame(rows)
df.to_csv("Airbnb_Open_Data.csv", index=False)
print(f"Sample dataset created: Airbnb_Open_Data.csv ({df.shape[0]} rows, {df.shape[1]} columns)")
